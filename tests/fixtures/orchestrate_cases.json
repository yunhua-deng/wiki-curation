{
  "cases": [
    {
      "name": "single_arxiv_url",
      "inputs": ["https://arxiv.org/abs/2605.26112"],
      "depth": "brief",
      "expected_sources_count": 1,
      "expected_primary_subtype": "arxiv_paper"
    },
    {
      "name": "multiple_urls_combined",
      "inputs": ["https://arxiv.org/abs/2605.26112 和 https://github.com/user/repo"],
      "depth": "brief",
      "expected_sources_count": 2
    },
    {
      "name": "url_plus_keyword",
      "inputs": ["https://arxiv.org/abs/2605.26112", "OpenAI 这家公司"],
      "depth": "brief",
      "expected_sources_count": 2
    },
    {
      "name": "github_repo_deep",
      "inputs": ["https://github.com/user/repo"],
      "depth": "deep",
      "expected_download_zip": true
    },
    {
      "name": "local_file",
      "inputs": ["./tests/fixtures/sample_paper.pdf"],
      "depth": "brief",
      "expected_skip_classify": true
    },
    {
      "name": "append_to_existing",
      "append_to": "2026-06-20_vla_survey",
      "inputs": ["https://github.com/new-org/vla-code"],
      "depth": "brief",
      "expected_output_path": "wiki/2026-06-20_vla_survey_brief.md"
    }
  ]
}
